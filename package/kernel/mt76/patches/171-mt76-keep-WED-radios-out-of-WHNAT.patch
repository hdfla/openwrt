Subject: [PATCH] wifi: mt76: keep active WED radios out of the WHNAT hook

WED and CPU-assisted WHNAT can be built together. Leave frames from an
attached WED radio on their existing receive path.

---
diff --git a/mac80211.c b/mac80211.c
--- a/mac80211.c
+++ b/mac80211.c
@@ -1579,7 +1579,8 @@
 
 #if IS_ENABLED(CONFIG_NET_AIROHA_WHNAT)
 	/* Looked up once per poll; the hook keeps the frames it takes. */
-	whnat_early = symbol_get(en75_whnat_upstream_early);
+	if (!mtk_wed_device_active(&dev->mmio.wed))
+		whnat_early = symbol_get(en75_whnat_upstream_early);
 #endif
 	list_for_each_entry_safe(skb, tmp, &list, list) {
 		skb_list_del_init(skb);
