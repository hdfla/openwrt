diff --git a/arch/mips/dts/econet,en751221-reference-u-boot.dtsi b/arch/mips/dts/econet,en751221-reference-u-boot.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/mips/dts/econet,en751221-reference-u-boot.dtsi
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include <linux/stringify.h>
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&uart0 {
+	bootph-all;
+};
+
+&binman {
+	spl-img {
+		filename = "u-boot-spl.img";
+
+		mkimage {
+			args = "-A", "mips", "-T", "standalone", "-O", "u-boot",
+			       "-C", "none", "-n", "EN7512 U-Boot SPL",
+			       "-a", __stringify(CONFIG_SPL_TEXT_BASE),
+			       "-e", __stringify(CONFIG_SPL_TEXT_BASE);
+
+			u-boot-spl {
+			};
+		};
+	};
+
+	en7512-uboot {
+		filename = "u-boot-en7512.bin";
+		pad-byte = <0xff>;
+
+		u-boot-tpl {
+			offset = <0x00000000>;
+			size = <0x00008000>;
+		};
+
+		ddr-blob {
+			type = "blob-ext";
+			filename = "arch/mips/mach-econet/en7512_ddr.bin";
+			offset = <0x00008000>;
+			size = <0x00004f70>;
+		};
+
+		spl {
+			type = "blob";
+			filename = "u-boot-spl.img";
+			offset = <0x00010000>;
+			size = <0x00040000>;
+		};
+
+		u-boot {
+			type = "blob";
+			filename = "u-boot.img";
+			offset = <0x00050000>;
+		};
+	};
+};
diff --git a/arch/mips/dts/econet,en751221-reference.dts b/arch/mips/dts/econet,en751221-reference.dts
new file mode 100644
--- /dev/null
+++ b/arch/mips/dts/econet,en751221-reference.dts
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+#include "econet,en751221.dtsi"
+
+/ {
+	model = "Airoha EN751221 reference board";
+	compatible = "econet,en751221-reference", "econet,en751221";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+};
diff --git a/arch/mips/dts/econet,en751221.dtsi b/arch/mips/dts/econet,en751221.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/mips/dts/econet,en751221.dtsi
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/reset/econet,en751221-scu.h>
+
+/ {
+	compatible = "econet,en751221", "airoha,en751221";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			compatible = "mips,mips34Kc";
+			device_type = "cpu";
+			reg = <0>;
+		};
+	};
+
+	aliases {
+		serial0 = &uart0;
+		ethernet0 = &gdm1;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x08000000>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		chip_scu: syscon@1fa20000 {
+			compatible = "airoha,chip-scu", "airoha,en751221-chip-scu", "syscon";
+			reg = <0x1fa20000 0x400>;
+		};
+
+		scuclk: system-controller@1fb00000 {
+			compatible = "airoha,en751221-scu", "syscon";
+			reg = <0x1fb00000 0x1000>;
+			airoha,chip-scu = <&chip_scu>;
+
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		system-controller@1fbf0200 {
+			compatible = "syscon", "simple-mfd";
+			reg = <0x1fbf0200 0xc0>;
+
+			pinctrl: pinctrl {
+				compatible = "airoha,en751221-pinctrl", "econet,en751221-pinctrl";
+				airoha,chip-scu = <&chip_scu>;
+
+			gpio-controller;
+				#gpio-cells = <2>;
+				gpio-ranges = <&pinctrl 0 13 29>;
+
+				interrupt-controller;
+				#interrupt-cells = <2>;
+
+				i2c_pins: i2c-pins {
+					mux {
+						function = "pon_i2c";
+						groups = "pon_i2c";
+					};
+				};
+
+				pon_pinctrl: pon {
+					mux {
+						function = "pon";
+						groups = "pon";
+					};
+				};
+			};
+		};
+
+		uart0: serial@1fbf0000 {
+			compatible = "econet,en7512-uart";
+			reg = <0x1fbf0000 0x30>;
+			clock-frequency = <20000000>;
+			current-speed = <115200>;
+			status = "disabled";
+		};
+
+		spi0: spi@1fa10000 {
+			compatible = "airoha,en7523-spi";
+			reg = <0x1fa10000 0x140>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		eth: ethernet@1fb50000 {
+			compatible = "econet,en751221-eth";
+			status = "disabled";
+			reg = <0x1fb50000 0x2600>,
+			      <0x1fb54000 0x1000>,
+			      <0x1fb55000 0x1000>,
+			      <0x1fbf9000 0x1000>;
+			reg-names = "fe", "qdma0", "qdma1", "gdmp";
+
+			resets = <&scuclk EN751221_FE_RST>,
+			         <&scuclk EN751221_FE_QDMA1_RST>,
+			         <&scuclk EN751221_FE_QDMA2_RST>,
