From 1554e87ae76f49eed7b787daaa956333188bf08f Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Fri, 16 Oct 2026 10:01:27 -0300
Subject: [PATCH 2/2] net: airoha: default WHNAT to automatic vif slots

Let netdevice events manage the WHNAT vif slots by default. mt76 then
only needs its pre-GRO receive hook, and each slot follows its interface
across mac80211 restarts without help from the WiFi driver.

On an Archer XR500v (MT76x2 5 GHz AP on VHT80, one mt7921u client,
iperf3 -P 4, 3 x 20 s per direction, nine interleaved RAM boots),
automatic slots with only the mt76 receive hook gave 304.9/325.2 Mbit/s
up/down, against 310.0/325.2 Mbit/s with mt76 managing the slots. Both
upload medians fall inside the other mode's run-to-run range.

whnat_auto_vifs=0 keeps the previous behaviour for an mt76 that still
registers its interfaces.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Cristian Papa <pcristian292@gmail.com>
---
 drivers/net/ethernet/airoha/Kconfig        |  8 +++++---
 drivers/net/ethernet/airoha/airoha_whnat.c | 13 ++++++++-----
 2 files changed, 13 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index 561658142..f349e381c 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -70,9 +70,11 @@ config NET_AIROHA_WHNAT
 	  WHNAT driver: mt76 hands received frames to the PPE through the LAN
 	  QDMA, and the PPE returns frames of flows bound towards a WiFi
 	  interface to the CPU, which queues them straight to that interface.
-	  The mt76 side registers its interfaces through
-	  en75_whnat_register_vif(). Nothing changes until the whnat_enable
-	  module parameter is set.
+	  Netdevice events give the WiFi interfaces their slots, so mt76 only
+	  offers received frames through en75_whnat_upstream_early(). Setting
+	  the whnat_auto_vifs module parameter to 0 makes the slots come from
+	  en75_whnat_register_vif() calls instead. The offload is on whenever
+	  a PPE is active; clearing whnat_enable stops offering new frames.
 
 	  If unsure, say N.
 
diff --git a/drivers/net/ethernet/airoha/airoha_whnat.c b/drivers/net/ethernet/airoha/airoha_whnat.c
index 5f482ce88..94113e4ea 100644
--- a/drivers/net/ethernet/airoha/airoha_whnat.c
+++ b/drivers/net/ethernet/airoha/airoha_whnat.c
@@ -15,10 +15,13 @@
  *   the vif index in its L2 tag. The PPE returns the rewritten frames with
  *   CRSN_22, and they are queued straight to the vif.
  *
- * mt76 registers the vif netdevs with en75_whnat_register_vif(), which gives
- * each one of the AIROHA_WHNAT_VIFS slots. The offload is on whenever it is
- * built and a PPE is active; clearing the whnat_enable module parameter hands
- * nothing more to the PPE.
+ * Each vif netdev holds one of the AIROHA_WHNAT_VIFS slots. By default
+ * netdevice events hand them out: a cfg80211 AP, AP VLAN or station netdev
+ * gets one when it comes up and loses it when it goes down, so mt76 only
+ * has to offer received frames. With the whnat_auto_vifs module parameter
+ * cleared, mt76 registers the vifs with en75_whnat_register_vif() instead.
+ * The offload is on whenever it is built and a PPE is active; clearing the
+ * whnat_enable module parameter hands nothing more to the PPE.
  */
 
 #include <linux/etherdevice.h>
@@ -41,7 +44,7 @@ static struct airoha_qdma __rcu *active_qdma;
 static DEFINE_MUTEX(vif_lock);
 static bool notifier_registered;
 
-static bool whnat_auto_vifs;
+static bool whnat_auto_vifs = true;
 module_param(whnat_auto_vifs, bool, 0444);
 MODULE_PARM_DESC(whnat_auto_vifs, "Manage WiFi slots through netdevice events");
 
