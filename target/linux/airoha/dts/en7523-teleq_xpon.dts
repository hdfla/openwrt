/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7523.dtsi"

/ {
	model = "TELEQ XPON";
	compatible = "teleq,xpon", "airoha,en7523";

	chosen {
		rootdisk = <&firmware>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-upgrade = &led_power;
		led-running = &led_power;
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		
		wifi {
			label = "wifi";
			linux,code = <KEY_WLAN>;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		}; 
	};

	leds {
		compatible = "gpio-leds";

		led_power: led@0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <0>;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};

		xpon_status: led@1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <1>;
			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
		};

		los: led@2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
		};

		led@3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <3>;
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
Factory u-boot and configuration:
	0x000000000000-0x000000080000 : "bootloader"
	0x000000080000-0x0000000c0000 : "romfile"
Combined into single u-boot:
mtd1:	0x00000000-0x00100000 : BL1 + FIP (BL2 + BL31 + BL33)
Calibration data partition is kept:
mtd2:	0x06dc0000-0x70000000 : art (reservearea)
Rests partition merged into single UBI partition:
mtd3:	0x00100000-0x6dc00000 : UBI (uboot env{1,2} + fit (firmware))
*/

&spi0 {
	flash@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@6dc0000 {
				label = "art";
				reg = <0x6dc0000 0x240000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom: eeprom@4c000 {
						reg = <0x4c000 0x1000>;
					};

					en7571_bob: en7571_bob@140497 {
						reg = <0x140497 0x200>;
					};

					gpon_sn: gpon_sn@1402BC {
						reg = <0x1402BC 0xC>;
					};
				};

                        };

			partition@100000 {
				label = "ubi";
				compatible = "linux,ubi";
				reg = <0x100000 0x6cc0000>;

				volumes {
					ubi-volume-ubootenv {
						volname = "ubootenv";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
						};
					};

					ubi-volume-ubootenv2 {
						volname = "ubootenv2";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";

							ubootenv_ethaddr: ethaddr {
								#nvmem-cell-cells = <1>;
							};
						};
					};

					firmware: ubi-volume-firmware {
						volname = "fit";
						compatible = "denx,fit-image";
					};
				};
			};
		};
	};
};

&usb0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&pcie1_slot1 {
	reg = <0x00000800 0 0 0 0>;
	#address-cells = <3>;
	#size-cells = <2>;

	mt7915@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		nvmem-cells = <&eeprom>;
		nvmem-cell-names = "eeprom";
		airoha,npu = <&npu>;
		airoha,eth = <&eth>;

		band@0 {
			reg = <0>;
			nvmem-cells = <&ubootenv_ethaddr 2>;
			nvmem-cell-names = "mac-address";
		};

		band@1 {
			reg = <1>;
			nvmem-cells = <&ubootenv_ethaddr 3>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&eth {
	status = "okay";
};

&i2c0 {
	status = "okay";

	en7571: lddla@70 {
		compatible = "airoha,en7571";
		reg = <0x70>;

		nvmem-cells = <&en7571_bob>;
		nvmem-cell-names = "calibration";

		#optical-frontend-cells = <0>;
	};
};

&xpon_phy {
	status = "okay";
};

&xpon {
	status = "okay";

	nvmem-cells = <&gpon_sn>;
	nvmem-cell-names = "gpon-serial-number";

	optical-frontends = <&en7571>;
	optical-frontend-names = "pon";

	leds = <&xpon_status>, <&los>;
	led-names = "pon", "los";
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";

	nvmem-cells = <&ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";

	/delete-property/ pcs-handle;

	airoha,xpon-managed;
	openwrt,netdev-name = "pon0";
};

&gdm1 {
	status = "okay";
	nvmem-cells = <&ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_port6 {
	nvmem-cells = <&ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&gsw_phy1_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};
